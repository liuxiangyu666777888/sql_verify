#!/usr/bin/env sh
set -eu

BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_VERSION="${MAVEN_VERSION:-3.9.6}"
MAVEN_DIR="$BASE_DIR/.mvn/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_DIR/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  mkdir -p "$BASE_DIR/.mvn"
  ARCHIVE="$BASE_DIR/.mvn/apache-maven-$MAVEN_VERSION-bin.zip"
  URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.zip"
  echo "Downloading Maven $MAVEN_VERSION..."
  curl -L "$URL" -o "$ARCHIVE"
  unzip -q "$ARCHIVE" -d "$BASE_DIR/.mvn"
  chmod +x "$MAVEN_BIN"
fi

exec "$MAVEN_BIN" "$@"
